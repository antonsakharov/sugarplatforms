{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sugarplatform.dev/schemas/audit-event.schema.json",
  "title": "Assessment deletion audit event",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "operationId", "organizationId", "workspaceId", "assessmentId", "actorUserId", "eventType", "outcome", "detail", "createdAt"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "operationId": { "type": "string", "format": "uuid" },
    "organizationId": { "type": "string", "minLength": 2, "maxLength": 100 },
    "workspaceId": { "type": "string", "minLength": 2, "maxLength": 100 },
    "assessmentId": { "type": "string", "minLength": 2, "maxLength": 100 },
    "actorUserId": { "type": "string", "minLength": 2, "maxLength": 100 },
    "eventType": { "enum": ["assessment.deletion.requested", "assessment.deletion.completed", "assessment.deletion.failed"] },
    "outcome": { "enum": ["pending", "success", "failure"] },
    "detail": { "type": "object" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
