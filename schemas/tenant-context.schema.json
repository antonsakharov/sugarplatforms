{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sugarplatforms.local/schemas/tenant-context.schema.json",
  "title": "Sugar Platform Diagnostic tenant context",
  "type": "object",
  "additionalProperties": false,
  "required": ["organization", "workspace"],
  "properties": {
    "organization": { "$ref": "#/$defs/organization" },
    "workspace": { "$ref": "#/$defs/workspace" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 2, "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "organization": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "createdAt"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 2, "maxLength": 120 }, "createdAt": { "type": "string", "format": "date-time" } }
    },
    "workspace": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "organizationId", "name", "createdAt"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "organizationId": { "$ref": "#/$defs/id" }, "name": { "type": "string", "minLength": 2, "maxLength": 120 }, "createdAt": { "type": "string", "format": "date-time" } }
    }
  }
}
