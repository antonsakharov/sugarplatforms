{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sugarplatforms.local/schemas/entity-id-graph.schema.json",
  "title": "Entity/ID Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assessmentId", "primaryEntity", "generatedFromDiagnosticAt", "nodes", "edges", "stats", "warnings"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "assessmentId": { "type": "string", "minLength": 1 },
    "primaryEntity": { "type": "string", "minLength": 1, "maxLength": 120 },
    "generatedFromDiagnosticAt": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "evidence", "acceptedFindingIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["primary_entity", "entity", "identifier", "system"] },
          "label": { "type": "string", "minLength": 1 },
          "sourceObjectId": { "type": "string" },
          "evidence": { "type": "array" },
          "acceptedFindingIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "source", "target", "label", "evidence", "factStatus"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["focused_identifier", "integration", "accepted_finding"] },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "label": { "type": "string" },
          "evidence": { "type": "array" },
          "factStatus": { "enum": ["direct", "derived"] }
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeCount", "edgeCount", "evidenceReferenceCount", "acceptedFindingCount"],
      "properties": {
        "nodeCount": { "type": "integer", "minimum": 1 },
        "edgeCount": { "type": "integer", "minimum": 0 },
        "evidenceReferenceCount": { "type": "integer", "minimum": 0 },
        "acceptedFindingCount": { "type": "integer", "minimum": 0 }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
