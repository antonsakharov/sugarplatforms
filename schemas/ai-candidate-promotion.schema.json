    "promotedFindingId": {"type": "string", "minLength": 1},
    "sourceCandidateGeneratedAt": {"type": "string", "minLength": 1},
    "sourceDiagnosticGeneratedAt": {"type": "string", "minLength": 1},
    "extractionApprovedAt": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
