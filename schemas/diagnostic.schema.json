{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sugarplatforms.dev/schemas/diagnostic.schema.json",
  "title": "DiagnosticEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "engineVersion", "assessmentId", "generatedAt", "extractionApprovedAt", "findings", "stats"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "engineVersion": {"const": "deterministic-v1"},
    "assessmentId": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "minLength": 1},
    "extractionApprovedAt": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ruleId", "ruleVersion", "category", "severity", "confidence", "factStatus", "title", "description", "businessImpact", "technicalImpact", "affectedObjectIds", "evidence", "recommendation", "validationQuestions", "reviewStatus"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "ruleId": {"type": "string", "minLength": 1},
          "ruleVersion": {"type": "string", "minLength": 1},
          "category": {"enum": ["entity_identity", "ownership"]},
          "severity": {"enum": ["low", "medium", "high"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "factStatus": {"const": "derived"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "businessImpact": {"type": "string", "minLength": 1},
          "technicalImpact": {"type": "string", "minLength": 1},
          "affectedObjectIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["segmentId", "artifactId", "artifactName", "locator", "evidenceType"], "properties": {"segmentId": {"type": "string"}, "artifactId": {"type": "string"}, "artifactName": {"type": "string"}, "locator": {"type": "string"}, "evidenceType": {"const": "direct"}}, "additionalProperties": false}},
          "recommendation": {"type": "string", "minLength": 1},
          "validationQuestions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "reviewStatus": {"enum": ["pending", "accepted", "rejected"]}
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeObjectCount", "ruleCount", "findingCount", "evidenceReferenceCount"],
      "properties": {
        "activeObjectCount": {"type": "integer", "minimum": 0},
        "ruleCount": {"type": "integer", "minimum": 0},
        "findingCount": {"type": "integer", "minimum": 0},
        "evidenceReferenceCount": {"type": "integer", "minimum": 0}
      }
    }
  }
}
