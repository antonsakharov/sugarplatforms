{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sugarplatforms.local/schemas/report.schema.json",
  "title": "Sugar Platform Diagnostic executive report preview",
  "type": "object",
  "required": ["schemaVersion", "reportVersion", "assessmentId", "generatedAt", "generatedFromDiagnosticAt", "title", "audience", "executiveSummary", "scope", "maturity", "topFindings", "recommendations", "actionPlan", "evidenceAppendix", "limitations"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "reportVersion": { "const": "preview-v1" },
    "assessmentId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generatedFromDiagnosticAt": { "type": "string", "format": "date-time" },
    "title": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "executiveSummary": { "type": "string", "minLength": 1 },
    "scope": { "type": "object" },
    "maturity": { "type": "object" },
    "topFindings": { "type": "array" },
    "recommendations": { "type": "object" },
    "actionPlan": { "type": "object" },
    "evidenceAppendix": { "type": "array" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
