NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
ASSESSMENT_DB_PATH=.data/sugar-platform-diagnostic.sqlite
ARTIFACT_STORAGE_PROVIDER=local
PRIVATE_ARTIFACT_ROOT=.data/private-artifacts
# For ARTIFACT_STORAGE_PROVIDER=supabase, set these server-only values.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=replace-with-server-secret
SUPABASE_STORAGE_BUCKET=sugar-platform-artifacts
SUPABASE_SIGNED_URL_TTL_SECONDS=300
MALWARE_SCANNER_PROVIDER=local
# CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000
LOCAL_ORGANIZATION_ID=local-org
LOCAL_ORGANIZATION_NAME=Local Organization
LOCAL_WORKSPACE_ID=local-demo
LOCAL_WORKSPACE_NAME=Local Diagnostic Workspace
LOCAL_AUTH_ENABLED=true
LOCAL_USER_ID=local-user
LOCAL_USER_EMAIL=local@sugarplatform.dev
LOCAL_USER_NAME=Local Sugar User
LOCAL_USER_ROLE=admin
MAX_ACTIVE_ASSESSMENTS_PER_WORKSPACE=1
MAX_UPLOAD_FILES=10
MAX_UPLOAD_BYTES=26214400
MAX_TOTAL_PAGES=150
MAX_PRIMARY_ENTITIES=1
MAX_ASSESSMENT_AI_COST_USD=25
LOG_LEVEL=info
